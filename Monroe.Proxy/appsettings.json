    },
    {
      "ModelPath": "mradermacher/Qwen3-30B-A3B-abliterated-erotic-i1-GGUF/Qwen3-30B-A3B-abliterated-erotic.i1-Q3_K_M.gguf",
      "Type": "nsfw",
