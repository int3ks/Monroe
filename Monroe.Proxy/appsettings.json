{
  //Name of the proxy, can be whatever you want
  "ModelName": "MONROE Proxy",
  //Port that the proxy listens on for incoming requests. Ports for agents will counted up i.e. 8123,8124,8125.....
  "ProxyPort": 8123,
  //Path to the llama.cpp executable that will run the models
  "LlamaExecutable": "C:/llama.cpp.vk/llama-server.exe",
  //Root directory where the models are stored, each model should be in its own subdirectory with the .gguf file directly inside it
  "ModelsRoot": "C:/Users/Admin/.lmstudio/models",
  //Global Parameters for all models
  "FlashAttention": true,
  "CacheType": "q8_0",
  "NoMmap": true,
  "BaseUrl": "http://localhost",

  "ClassifierModel": {
    //ModelPath to use for classification of input to route to the correct model, should be a smaller, faster model
    "ModelPath": "lmstudio-community/Llama-3.2-3B-Instruct-GGUF/Llama-3.2-3B-Instruct-Q4_K_M.gguf",
    "ContextSize": 2048
  },
  "Models": [
    {
      "ModelPath": "lmstudio-community/Qwen3-VL-8B-Instruct-GGUF/Qwen3-VL-8B-Instruct-Q4_K_M.gguf",
      //Type for the Classifier to route to, can be whatever you want but should be descriptive of the model's strengths or intended use
      "Type": "vision",
      ///"ContextSize": 16384,
      "ContextSize": 8192,
      //Rules for the classifier to determine when to route to this model, these are just examples and can be whatever you want, the more specific the better for accurate routing
      "Rules": {
        "UseFor": [
          "image input",
          "screenshots",
          "OCR",
          "visual reasoning"
        ]
      }
    },
    {
      "ModelPath": "lmstudio-community/Qwen3-Coder-Next-GGUF/Qwen3-Coder-Next-Q4_K_M.gguf",
      "Type": "coder",
      "ContextSize": 16384,
      "Rules": {
        "UseFor": [
          "programming",
          "debugging",
          "technical tasks",
          "c#",
          "dotnet",
          "python",
          "java",
          "node.js",
          "web development",
          "c++"
            ,
          "general chat",
          "small talk",
          "greetings",
          "casual chat",
